# Copy to .env locally; configure the same variables in Render for production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-render-service.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-cloudflare-pages-domain.pages.dev,http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=https://your-render-service.onrender.com,https://your-cloudflare-pages-domain.pages.dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
